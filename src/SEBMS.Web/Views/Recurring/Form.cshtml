@using SEBMS.Domain.Enums
@model RecurringFormViewModel
@{
    var editing = Model.Id is not null;
    ViewData["Title"] = editing ? "Edit recurring transaction" : "Add recurring transaction";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="auth-card" style="margin-top:1rem">
            <h1>@ViewData["Title"]</h1>
            <p class="subtitle">A transaction is recorded automatically on each due date, starting from the start date.</p>
            <form method="post" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="IsActive" />
                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" class="form-select">
                        <option value="">Select a category…</option>
                        @foreach (var group in Model.Categories.GroupBy(c => c.Type).OrderByDescending(g => g.Key))
                        {
                            <optgroup label="@group.Key">
                                @foreach (var c in group.OrderBy(c => c.Name))
                                {
                                    <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label asp-for="Frequency" class="form-label"></label>
                        <select asp-for="Frequency" class="form-select">
                            @foreach (var f in Enum.GetValues<RecurrenceFrequency>())
                            {
                                <option value="@f" selected="@(Model.Frequency == f)">@f</option>
                            }
                        </select>
                        <span asp-validation-for="Frequency" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <label asp-for="StartDate" class="form-label"></label>
                        <input asp-for="StartDate" type="date" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label asp-for="EndDate" class="form-label"></label>
                        <input asp-for="EndDate" type="date" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Note" class="form-label"></label>
                    <input asp-for="Note" class="form-control" maxlength="500" placeholder="Optional, e.g. Netflix" />
                    <span asp-validation-for="Note" class="text-danger"></span>
                </div>
                @if (editing)
                {
                    <p class="text-muted small">Changing the amount, category, note or end date applies to future occurrences only. Changing the start date or frequency restarts the schedule: a start date of today or later begins on that date, an earlier one resumes from tomorrow. Past dates are never re-created.</p>
                }
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@(editing ? "Save changes" : "Add recurring")</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
