@using SEBMS.Application.Recurring
@using SEBMS.Domain.Enums
@model List<RecurringResponse>
@{
    ViewData["Title"] = "Recurring";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Recurring transactions</h1>
    <a asp-action="Create" class="btn btn-primary">+ Add recurring</a>
</div>
<p class="text-muted">Rent, salary, subscriptions and other repeating items. A real transaction is added automatically each time one falls due.</p>

@if (TempData["Success"] is string ok) { <div class="alert alert-success py-2">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger py-2">@err</div> }

<div class="card"><div class="card-body">
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">Nothing set up yet. Add your rent, salary or a subscription and it will be recorded for you.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Category</th><th class="d-none d-md-table-cell">Note</th><th>Repeats</th><th>Next</th><th class="text-end">Amount</th><th></th></tr></thead>
                <tbody>
                @foreach (var r in Model)
                {
                    var income = r.Type == TransactionType.Income;
                    <tr class="@(r.NextDueDate is null ? "text-muted" : "")">
                        <td>@r.CategoryName <span class="badge rounded-pill @(income ? "text-bg-success" : "text-bg-danger") ms-1">@r.Type</span></td>
                        <td class="text-muted d-none d-md-table-cell">@r.Note</td>
                        <td class="text-nowrap">@r.Frequency</td>
                        <td class="text-nowrap">
                            @if (r.NextDueDate is { } next)
                            {
                                @next.ToString("dd MMM yyyy")
                            }
                            else
                            {
                                <span class="badge rounded-pill text-bg-light border">@(r.IsFinished ? "Finished" : "Paused")</span>
                            }
                        </td>
                        <td class="text-end fw-semibold text-nowrap @(income ? "text-success" : "text-danger")">@(income ? "+" : "−")@Money.Format(r.Amount)</td>
                        <td class="text-end">
                          <div class="d-inline-flex flex-column flex-md-row gap-1">
                            <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            @if (!r.IsFinished)
                            {
                                <form asp-action="Toggle" asp-route-id="@r.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">@(r.IsActive ? "Pause" : "Resume")</button>
                                </form>
                            }
                            <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this recurring transaction? Transactions it already created are kept.');">
                                <button type="submit" class="btn btn-sm btn-outline-secondary text-danger">Delete</button>
                            </form>
                          </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div></div>
