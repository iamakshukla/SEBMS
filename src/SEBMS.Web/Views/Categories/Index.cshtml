@using SEBMS.Application.Categories
@using SEBMS.Domain.Enums
@model List<CategoryResponse>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Categories</h1>
    <a asp-action="Create" class="btn btn-primary">+ Add category</a>
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success py-2">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger py-2">@err</div> }

<div class="row g-3">
@foreach (var type in new[] { TransactionType.Expense, TransactionType.Income })
{
    var items = Model.Where(c => c.Type == type).OrderByDescending(c => c.IsDefault).ThenBy(c => c.Name).ToList();
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h2 class="h5 @(type == TransactionType.Income ? "text-success" : "text-danger")">@type categories</h2>
            @if (items.Count == 0)
            {
                <p class="text-muted mb-0">None yet.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                @foreach (var c in items)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent">
                        <span>@c.Name @if (c.IsDefault) { <span class="badge rounded-pill text-bg-light border ms-1">Default</span> }</span>
                        @if (!c.IsDefault)
                        {
                            <span class="text-nowrap">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Delete category @c.Name?');">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary text-danger">Delete</button>
                                </form>
                            </span>
                        }
                    </li>
                }
                </ul>
            }
        </div></div>
    </div>
}
</div>
