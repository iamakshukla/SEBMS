@using SEBMS.Domain.Enums
@model TransactionFormViewModel
@{
    ViewData["Title"] = "Admin - Edit transaction";
    string? returnUserId = ViewBag.ReturnUserId;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="auth-card" style="margin-top:1rem">
            <h1>Edit transaction</h1>
            <div class="alert alert-warning py-2 small">Admin edit: this transaction belongs to <strong>@ViewBag.OwnerEmail</strong>.</div>
            <form method="post" asp-action="EditTransaction" asp-route-id="@Model.Id" asp-route-userId="@returnUserId">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" class="form-select">
                        <option value="">Select a category…</option>
                        @foreach (var group in Model.Categories.GroupBy(c => c.Type).OrderByDescending(g => g.Key))
                        {
                            <optgroup label="@group.Key">
                                @foreach (var c in group.OrderBy(c => c.Name))
                                {
                                    <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label asp-for="TransactionDate" class="form-label"></label>
                        <input asp-for="TransactionDate" type="date" value="@Model.TransactionDate?.ToString("yyyy-MM-dd")" class="form-control" />
                        <span asp-validation-for="TransactionDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Note" class="form-label"></label>
                    <input asp-for="Note" class="form-control" maxlength="500" placeholder="Optional" />
                    <span asp-validation-for="Note" class="text-danger"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <a asp-action="Transactions" asp-route-userId="@returnUserId" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
