@using SEBMS.Application.Admin
@model List<AdminCategoryResponse>
@{
    ViewData["Title"] = "Admin - Categories";
}
<partial name="_Tabs" />

<div class="card"><div class="card-body">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Name</th><th>Type</th><th>Owner</th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@c.Type</td>
                    <td>@(c.OwnerEmail ?? "Shared default")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div></div>
