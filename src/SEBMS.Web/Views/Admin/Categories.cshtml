@using SEBMS.Application.Admin
@model List<AdminCategoryResponse>
@{
    ViewData["Title"] = "Admin - Categories";
}
<partial name="_Tabs" />

<div class="card"><div class="card-body">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Name</th><th>Type</th><th>Owner</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@c.Type</td>
                    <td>@(c.OwnerEmail ?? "Shared default")</td>
                    <td class="text-end">
                        @if (!c.IsDefault)
                        {
                          <div class="d-inline-flex flex-column flex-md-row gap-1">
                            <a asp-action="EditCategory" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="DeleteCategory" asp-route-id="@c.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete category @c.Name of @c.OwnerEmail?');">
                                <button type="submit" class="btn btn-sm btn-outline-secondary text-danger">Delete</button>
                            </form>
                          </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div></div>
