@using SEBMS.Application.Admin
@using SEBMS.Domain.Enums
@model List<AdminTransactionResponse>
@{
    ViewData["Title"] = "Admin - Transactions";
    string? userId = ViewBag.UserId;
}
<partial name="_Tabs" />

<div class="card"><div class="card-body">
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">No transactions found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Date</th><th>User</th><th>Category</th><th class="d-none d-md-table-cell">Note</th><th class="text-end">Amount</th><th></th></tr></thead>
                <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="text-nowrap">@t.TransactionDate.ToString("yyyy-MM-dd")</td>
                        <td>@t.UserEmail</td>
                        <td>@t.CategoryName</td>
                        <td class="text-muted d-none d-md-table-cell">@t.Note</td>
                        <td class="text-end text-nowrap @(t.Type == TransactionType.Income ? "text-success" : "text-danger")">
                            @(t.Type == TransactionType.Income ? "+" : "-")@Money.Format(t.Amount) @t.CurrencyCode
                        </td>
                        <td class="text-end">
                          <div class="d-inline-flex flex-column flex-md-row gap-1">
                            <a asp-action="EditTransaction" asp-route-id="@t.Id" asp-route-userId="@userId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="DeleteTransaction" asp-route-id="@t.Id" asp-route-userId="@userId" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this transaction of @t.UserEmail?');">
                                <button type="submit" class="btn btn-sm btn-outline-secondary text-danger">Delete</button>
                            </form>
                          </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div></div>
