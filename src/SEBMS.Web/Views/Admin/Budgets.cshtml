@using SEBMS.Application.Admin
@model List<AdminBudgetResponse>
@{
    ViewData["Title"] = "Admin - Budgets";
    string? userId = ViewBag.UserId;
}
<partial name="_Tabs" />

<div class="card"><div class="card-body">
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">No budgets found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Month</th><th>User</th><th>Category</th><th class="text-end">Budget</th><th></th></tr></thead>
                <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.BudgetYear-@b.BudgetMonth.ToString("00")</td>
                        <td>@b.UserEmail</td>
                        <td>@b.CategoryName</td>
                        <td class="text-end">@Money.Format(b.Amount)</td>
                        <td class="text-end">
                          <div class="d-inline-flex flex-column flex-md-row gap-1">
                            <a asp-action="EditBudget" asp-route-id="@b.Id" asp-route-userId="@userId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="DeleteBudget" asp-route-id="@b.Id" asp-route-userId="@userId" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this budget of @b.UserEmail?');">
                                <button type="submit" class="btn btn-sm btn-outline-secondary text-danger">Delete</button>
                            </form>
                          </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div></div>
