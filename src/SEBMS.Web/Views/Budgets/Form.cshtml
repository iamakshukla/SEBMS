@model BudgetFormViewModel
@{
    var editing = Model.Id is not null;
    ViewData["Title"] = editing ? "Edit budget" : "Add budget";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="auth-card" style="margin-top:1rem">
            <h1>@ViewData["Title"]</h1>
            <p class="subtitle">Set a monthly spending limit for an expense category.</p>
            <form method="post" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" class="form-select">
                        <option value="">Select a category…</option>
                        @foreach (var c in Model.Categories.OrderBy(c => c.Name))
                        {
                            <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <label asp-for="Month" class="form-label"></label>
                        <select asp-for="Month" class="form-select">
                            @for (var m = 1; m <= 12; m++)
                            {
                                <option value="@m" selected="@(Model.Month == m)">@Money.MonthName(m)</option>
                            }
                        </select>
                        <span asp-validation-for="Month" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label asp-for="Year" class="form-label"></label>
                        <input asp-for="Year" type="number" min="2000" max="2100" class="form-control" />
                        <span asp-validation-for="Year" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Amount" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">₹</span>
                        <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
                    </div>
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@(editing ? "Save changes" : "Add budget")</button>
                    <a asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
