@using System.Text.Json
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var chartData = JsonSerializer.Serialize(new
    {
        spending = Model.Spending.Items.Select(i => new { name = i.CategoryName, total = i.Total, pct = i.Percentage }),
        budgets = Model.Budgets.Select(b => new { name = b.CategoryName, amount = b.Amount, spent = b.Spent }),
        trend = Model.Trend.Months.Select(t => new { month = Money.MonthName(t.Month).Substring(0, 3), income = t.Income, expense = t.Expense })
    }).Replace("<", "\\u003c");   // keep the JSON safe inside a <script> block
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Money.MonthName(Model.Month) @Model.Year</h1>
    <div class="d-flex flex-wrap gap-2 align-items-center">
    <div class="btn-group btn-group-sm" role="group" aria-label="Download this month's report">
        <a asp-controller="Reports" asp-action="Monthly" asp-route-year="@Model.Year" asp-route-month="@Model.Month" asp-route-format="pdf" class="btn btn-outline-secondary">Report PDF</a>
        <a asp-controller="Reports" asp-action="Monthly" asp-route-year="@Model.Year" asp-route-month="@Model.Month" asp-route-format="xlsx" class="btn btn-outline-secondary">Excel</a>
    </div>
    <form method="get" class="d-flex gap-2">
        <select name="month" class="form-select form-select-sm" aria-label="Month" onchange="this.form.submit()">
            @for (var m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(m == Model.Month)">@Money.MonthName(m)</option>
            }
        </select>
        <input type="number" name="year" value="@Model.Year" min="2000" max="2100" class="form-control form-control-sm" style="width:90px" aria-label="Year" onchange="this.form.submit()" />
    </form>
    </div>
</div>

@{
    var alerts = Model.Budgets
        .Select(b => (Budget: b, Level: BudgetStatus.LevelOf(b)))
        .Where(x => x.Level != BudgetLevel.Ok)
        .OrderByDescending(x => x.Level)
        .ThenByDescending(x => BudgetStatus.PercentUsed(x.Budget.Spent, x.Budget.Amount))
        .ToList();
}
@if (alerts.Count > 0)
{
    <div class="alert @(alerts.Any(a => a.Level == BudgetLevel.Over) ? "alert-danger" : "alert-warning") mb-3" role="alert">
        <div class="fw-semibold mb-1">Budget alert@(alerts.Count > 1 ? "s" : "")</div>
        <ul class="mb-0 ps-3">
            @foreach (var a in alerts)
            {
                <li>@BudgetStatus.Message(a.Budget)</li>
            }
        </ul>
        <a asp-controller="Budgets" asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="alert-link small">Manage budgets</a>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card stat-card income h-100"><div class="card-body">
            <div class="stat-label">Income</div>
            <div class="stat-value text-success">@Money.Format(Model.Summary.TotalIncome)</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card expense h-100"><div class="card-body">
            <div class="stat-label">Expenses</div>
            <div class="stat-value text-danger">@Money.Format(Model.Summary.TotalExpense)</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card net h-100"><div class="card-body">
            <div class="stat-label">Net balance</div>
            <div class="stat-value @(Model.Summary.Net < 0 ? "text-danger" : "text-success")">@Money.Format(Model.Summary.Net)</div>
            <div class="text-muted small">@Model.Summary.TransactionCount transaction(s)</div>
        </div></div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h2 class="h5">Spending by category</h2>
            @if (Model.Spending.Items.Count == 0)
            {
                <p class="text-muted mb-0">No expenses this month.</p>
            }
            else
            {
                <div class="chart-box">
                    <canvas id="spendingChart" role="img"
                            aria-label="Doughnut chart of spending by category: @string.Join(", ", Model.Spending.Items.Select(i => $"{i.CategoryName} {i.Percentage:0.#}%"))"></canvas>
                </div>
            }
        </div></div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h2 class="h5">Budgets</h2>
            @if (Model.Budgets.Count == 0)
            {
                <p class="text-muted mb-0">No budgets set for this month.</p>
            }
            else
            {
                <div class="chart-box" style="height:@(Math.Max(220, Model.Budgets.Count * 56 + 70))px">
                    <canvas id="budgetChart" role="img"
                            aria-label="Bar chart of budget versus spent per category: @string.Join("; ", Model.Budgets.Select(b => $"{b.CategoryName} spent {Money.Format(b.Spent)} of {Money.Format(b.Amount)}"))"></canvas>
                </div>
            }
        </div></div>
    </div>
</div>

<div class="card mb-4"><div class="card-body">
    <h2 class="h5">@Model.Year by month</h2>
    <div class="chart-box mb-3">
        <canvas id="trendChart" role="img" aria-label="Column chart of income and expense for each month of @Model.Year"></canvas>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Month</th><th class="text-end">Income</th><th class="text-end">Expense</th><th class="text-end">Net</th></tr></thead>
            <tbody>
            @foreach (var t in Model.Trend.Months)
            {
                <tr class="@(t.Month == Model.Month ? "table-active" : "")">
                    <td>@Money.MonthName(t.Month)</td>
                    <td class="text-end">@Money.Format(t.Income)</td>
                    <td class="text-end">@Money.Format(t.Expense)</td>
                    <td class="text-end @(t.Net < 0 ? "text-danger" : "")">@Money.Format(t.Net)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div></div>

<script id="dashboard-data" type="application/json">@Html.Raw(chartData)</script>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.js"></script>
    <script src="~/js/dashboard-charts.js" asp-append-version="true"></script>
}
